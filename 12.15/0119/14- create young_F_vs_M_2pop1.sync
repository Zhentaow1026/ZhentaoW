BASE=/mnt/data/wright/home/u8021786/popoolation2_project

cat > $BASE/make_young_F_vs_M_2pop1_fromMergedBam.sbatch <<'EOF'
#!/bin/bash
#SBATCH --job-name=young_2pop_sync
#SBATCH --partition=Standard
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=24:00:00
#SBATCH --output=/mnt/data/wright/home/u8021786/popoolation2_project/slurm_%j_young_2pop_sync.out
#SBATCH --error=/mnt/data/wright/home/u8021786/popoolation2_project/slurm_%j_young_2pop_sync.err

set -euo pipefail

BASE=/mnt/data/wright/home/u8021786/popoolation2_project
REF=$BASE/ref/Amel_HAv3.1.fna
MAPDIR=$BASE/map
OUTDIR=$BASE/sync

source /opt/conda/etc/profile.d/conda.sh
conda activate popoolation2

P2JAR="$CONDA_PREFIX/share/popoolation2-1.201-0/mpileup2sync.jar"

SCRATCH=/mnt/data/wright/home/scratch/u8021786/young_2pop_sync_$SLURM_JOB_ID
mkdir -p "$SCRATCH" "$OUTDIR"

# -----------------------
# 1) 自动收集 BAM 列表
# -----------------------
# Young feral: 10 pools
mapfile -t FERAL_BAMS < <(ls -1 $MAPDIR/young_feral/YoungBF*.bam | sort -V)

# Young managed: 10 pools
mapfile -t MANAGED_BAMS < <(ls -1 $MAPDIR/young_managed/YoungBM*.bam | sort -V)

# -----------------------
# 2) sanity check + 打印列表（防复制粘贴污染）
# -----------------------
[[ ${#FERAL_BAMS[@]} -gt 0 ]] || { echo "No feral BAMs matched: $MAPDIR/young_feral/YoungBF*.bam" >&2; exit 1; }
[[ ${#MANAGED_BAMS[@]} -gt 0 ]] || { echo "No managed BAMs matched: $MAPDIR/young_managed/YoungBM*.bam" >&2; exit 1; }

echo "=== FERAL BAMS (n=${#FERAL_BAMS[@]}) ==="
printf "  %s\n" "${FERAL_BAMS[@]}"

echo "=== MANAGED BAMS (n=${#MANAGED_BAMS[@]}) ==="
printf "  %s\n" "${MANAGED_BAMS[@]}"

for b in "${FERAL_BAMS[@]}" "${MANAGED_BAMS[@]}"; do
  [[ -f "$b" ]] || { echo "Missing BAM: $b" >&2; exit 1; }
  [[ -f "$b.bai" ]] || { echo "Missing BAI: $b.bai" >&2; exit 1; }
done

# 如果你“必须严格是 10 个 pool”，这里直接卡死（推荐）
[[ ${#FERAL_BAMS[@]} -eq 10 ]] || { echo "Expected 10 feral BAMs, got ${#FERAL_BAMS[@]}"; exit 1; }
[[ ${#MANAGED_BAMS[@]} -eq 10 ]] || { echo "Expected 10 managed BAMs, got ${#MANAGED_BAMS[@]}"; exit 1; }

# -----------------------
# 3) 合并 BAM（同组内合并）
# -----------------------
FERAL_MERGED="$SCRATCH/young_feral_merged.bam"
MANAGED_MERGED="$SCRATCH/young_managed_merged.bam"

echo "[1/4] Merging feral -> $FERAL_MERGED"
samtools merge -@ "$SLURM_CPUS_PER_TASK" -f "$FERAL_MERGED" "${FERAL_BAMS[@]}"
samtools index -@ "$SLURM_CPUS_PER_TASK" "$FERAL_MERGED"

echo "[2/4] Merging managed -> $MANAGED_MERGED"
samtools merge -@ "$SLURM_CPUS_PER_TASK" -f "$MANAGED_MERGED" "${MANAGED_BAMS[@]}"
samtools index -@ "$SLURM_CPUS_PER_TASK" "$MANAGED_MERGED"

# -----------------------
# 4) 一次 mpileup + mpileup2sync -> 2-pop sync
# -----------------------
MPI="$SCRATCH/young_F_vs_M_2pop1.mpileup"
SYNC_OUT="$SCRATCH/young_F_vs_M_2pop1.sync"

echo "[3/4] mpileup -> $MPI"
samtools mpileup -B -f "$REF" "$FERAL_MERGED" "$MANAGED_MERGED" > "$MPI"

echo "[4/4] mpileup2sync -> $SYNC_OUT"
java -Xmx44g -jar "$P2JAR" \
  --input "$MPI" \
  --output "$SYNC_OUT" \
  --fastq-type sanger \
  --min-qual 20 \
  --threads "$SLURM_CPUS_PER_TASK"

# 输出到正式目录
mv "$SYNC_OUT" "$OUTDIR/young_F_vs_M_2pop1.sync"

# quick check：应为 5 列（chr pos ref + 2 populations）
echo -n "NF(out) = "
awk -F'\t' '{print NF; exit}' "$OUTDIR/young_F_vs_M_2pop1.sync"

echo "DONE: $OUTDIR/young_F_vs_M_2pop1.sync"
rm -rf "$SCRATCH"
EOF



