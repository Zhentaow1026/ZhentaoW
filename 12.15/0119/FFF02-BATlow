library(poolfstat)

BASE <- "/mnt/data/wright/home/u8021786/popoolation2_project"
sync_file <- paste0(BASE, "/sync/batlow_exclF1_F12_keepM1_M12.sync")

out_dir <- paste0(BASE, "/perm_batlow_n1000_max942")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)

# 26 pools: first 12 feral, next 14 managed; each pool 10 bees -> haploid poolsize = 20
poolsizes <- rep(20, 26)
labels <- c(rep("feral", 12), rep("managed", 14))

# sync -> pooldata (max coverage = 942)
pd <- popsync2pooldata(
  sync.file = sync_file,
  poolsizes = poolsizes,
  min.rc = 4,
  min.cov.per.pool = 10,
  max.cov.per.pool = 942,
  min.maf = 0.05,
  noindel = TRUE,
  nthreads = 2
)

# helper: aggregate pools into 2 group pools based on labels
make_2pool <- function(pd, labs){
  Fidx <- which(labs=="feral")
  Midx <- which(labs=="managed")

  ref <- pd@refallele.readcount
  cov <- pd@readcoverage

  new("pooldata",
      npools=2,
      nsnp=pd@nsnp,
      refallele.readcount=cbind(rowSums(ref[,Fidx]), rowSums(ref[,Midx])),
      readcoverage=cbind(rowSums(cov[,Fidx]), rowSums(cov[,Midx])),
      snp.info=pd@snp.info,
      poolsizes=c(sum(pd@poolsizes[Fidx]), sum(pd@poolsizes[Midx])),
      poolnames=c("feral","managed")
  )
}

# observed FST
pd_obs2 <- make_2pool(pd, labels)
fst_obs2 <- computeFST(pd_obs2, method="Anova", verbose=FALSE)
obs_fst <- fst_obs2$Fst[1]

# permutation
set.seed(1)
nperm <- 1000
null_fst <- numeric(nperm)

for(i in 1:nperm){
  perm_labels <- sample(labels)  # preserves 12/14 counts
  pd_perm2 <- make_2pool(pd, perm_labels)
  null_fst[i] <- computeFST(pd_perm2, method="Anova", verbose=FALSE)$Fst[1]
}

# one-sided p-value
pval <- (sum(null_fst >= obs_fst) + 1) / (nperm + 1)

# write outputs
write.table(null_fst,
            file=paste0(out_dir, "/null_fst.txt"),
            row.names=FALSE, col.names=FALSE, quote=FALSE)

writeLines(c(
  paste0("sync_file\t", sync_file),
  paste0("nsnp_used\t", pd@nsnp),
  paste0("nperm\t", nperm),
  paste0("obs_fst\t", format(obs_fst, digits=10)),
  paste0("pvalue\t", format(pval, digits=10)),
  "filters\tmin.rc=4; min.cov.per.pool=10; max.cov.per.pool=942; min.maf=0.05; noindel=TRUE"
), con=paste0(out_dir, "/summary.txt"))

cat("DONE\n")
cat("Observed FST:", obs_fst, "\n")
cat("Permutation p-value:", pval, "\n")
cat("Outputs in:", out_dir, "\n")
RSCRIPT
