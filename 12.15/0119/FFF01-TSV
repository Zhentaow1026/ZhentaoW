#!/usr/bin/env bash
set -euo pipefail

# ===== input sync (你刚才用的 young_all.sync) =====
SYNC="sync/young_all.sync"

OUTDIR="results/coverage"
OUT_PREFIX="young_all_20pools"
COV_TSV="${OUTDIR}/${OUT_PREFIX}.coverage.tsv"

# 推荐 max coverage 用哪个分位数：99 或 99.5
PERC=99

mkdir -p "$OUTDIR"
[[ -s "$SYNC" ]] || { echo "Missing/empty SYNC: $SYNC" >&2; exit 1; }

echo "[INFO] Input sync: $SYNC"
echo "[INFO] Output cov:  $COV_TSV"
echo "[INFO] Percentile for max coverage: p$PERC"
echo

# ===== 1) 从 sync 计算每个 pool 的 coverage（A+T+C+G） =====
# sync格式：chr pos ref  pool1  pool2 ... poolN
# 每个 pool 字段一般是 A:T:C:G:N:del (至少前4个是ATCG)
awk -F'\t' -v OFS='\t' '
{
  # pools 从第4列开始到最后一列
  for(i=4;i<=NF;i++){
    split($i,a,":");
    cov = a[1]+a[2]+a[3]+a[4];
    printf "%s", cov;
    if(i<NF) printf OFS; else printf "\n";
  }
}' "$SYNC" > "$COV_TSV"

# ===== 2) Python 汇总每个 pool 的分布，并给推荐 max.cov.per.pool =====
python - <<PY
import numpy as np, math

cov = np.loadtxt("${COV_TSV}")
if cov.ndim == 1:
    cov = cov.reshape(-1, 1)

n_sites, n_pools = cov.shape
print(f"[INFO] sites: {n_sites}, pools: {n_pools}")

perc = float(${PERC})

def show(j, x):
    x = x.astype(float)
    print(f"== Pool{j+1} ==")
    print("min:", int(np.min(x)), "mean:", round(float(np.mean(x)),1), "max:", int(np.max(x)))
    for p in [50, 75, 90, 95, 97.5, 99, 99.5]:
        if p <= 99.5:
            print(f"p{p}:", round(float(np.percentile(x,p)),1))
    print()

# 每个 pool 打印统计
for j in range(n_pools):
    show(j, cov[:, j])

# 推荐 max.cov.per.pool：所有 pools 的 pPERC 里取最大，再向上取整
pvals = [np.percentile(cov[:, j], perc) for j in range(n_pools)]
mc = max(pvals)
print(f"[SUGGEST] max.cov.per.pool (max of per-pool p{perc}) =", int(math.ceil(mc)))

# 也给一个参考的 min coverage：每 pool p5 的最大值（可选参考）
p5 = max(np.percentile(cov[:, j], 5) for j in range(n_pools))
print("[REF] p5 coverage across pools (max of per-pool p5) =", int(math.floor(p5)))
print("[WROTE]", "${COV_TSV}")
PY
EOF

