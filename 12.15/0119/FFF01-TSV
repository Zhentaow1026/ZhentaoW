library(poolfstat)

############################
# 0) Paths (按你项目默认目录)
############################
BASE <- "/mnt/data/wright/home/u8021786/popoolation2_project"
sync_file <- file.path(BASE, "sync/young_all.sync")
meta_file <- file.path(BASE, "young_pools.tsv")

out_dir <- file.path(BASE, "perm_young_perlocus")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)

############################
# 1) Read metadata (自动读 poolsize + group)
############################
meta <- read.table(meta_file, header=TRUE, sep="\t", stringsAsFactors=FALSE)
stopifnot(all(c("pool","group","poolsize") %in% colnames(meta)))

# 重要：meta 的顺序必须和 sync 里 pool 的顺序一致（你之前就是这么建的）
poolsizes <- meta$poolsize
poolnames <- meta$pool
labels0   <- meta$group  # "feral" / "managed"

nF <- sum(labels0 == "feral")
nM <- sum(labels0 == "managed")
stopifnot(nF > 1, nM > 1, nF + nM == length(labels0))

############################
# 2) sync -> pooldata (严格按教程函数)
############################
pd <- popsync2pooldata(
  sync.file = sync_file,
  poolsizes = poolsizes,
  poolnames = poolnames,
  min.rc = 4,
  min.cov.per.pool = 10,
  max.cov.per.pool = 1000000,
  min.maf = 0.05,
  noindel = TRUE,
  nthreads = 2
)

############################
# helper: given a label vector, aggregate into 2 group pools then compute per-locus FST
############################
calc_mean_perlocus_fst <- function(pd, labels) {
  Fidx <- which(labels == "feral")
  Midx <- which(labels == "managed")

  ref <- pd@refallele.readcount
  cov <- pd@readcoverage

  refF <- rowSums(ref[, Fidx, drop=FALSE])
  covF <- rowSums(cov[, Fidx, drop=FALSE])
  refM <- rowSums(ref[, Midx, drop=FALSE])
  covM <- rowSums(cov[, Midx, drop=FALSE])

  pd2 <- new("pooldata",
    npools = 2L,
    nsnp = pd@nsnp,
    refallele.readcount = cbind(refF, refM),
    readcoverage = cbind(covF, covM),
    snp.info = pd@snp.info,
    poolsizes = c(sum(pd@poolsizes[Fidx]), sum(pd@poolsizes[Midx])),
    poolnames = c("feral_agg", "managed_agg")
  )

  res <- computeFST(pd2, method="Anova", struct=NULL, verbose=FALSE)

  # 老师说的“per locus Fst”就是这里：res$snp.Fstats$FST
  fst_vec <- res$snp.Fstats$FST
  mean_fst <- mean(fst_vec, na.rm=TRUE)

  # 顺便也把 poolfstat 默认的 genome-wide ratio-of-sums FST 带出来（便于你对照）
  overall_fst <- res$FST[1]

  return(list(mean_perlocus=mean_fst, overall=overall_fst))
}

############################
# 3) Observed statistic (按真实标签)
############################
obs <- calc_mean_perlocus_fst(pd, labels0)
cat("Observed mean(per-locus FST) =", obs$mean_perlocus, "\n")
cat("Observed overall (ratio-of-sums) FST =", obs$overall, "\n")

############################
# 4) Permutation: swap labels on pools (保持 nF/nM 不变)
############################
nperm <- 50
set.seed(1)

null_mean <- numeric(nperm)
null_overall <- numeric(nperm)

for (i in 1:nperm) {
  idx <- sample(seq_along(labels0))
  perm_labels <- rep("managed", length(labels0))
  perm_labels[idx[1:nF]] <- "feral"

  tmp <- calc_mean_perlocus_fst(pd, perm_labels)
  null_mean[i] <- tmp$mean_perlocus
  null_overall[i] <- tmp$overall
}

# one-sided p-value: P(null >= observed)
pval_mean <- (sum(null_mean >= obs$mean_perlocus) + 1) / (nperm + 1)
pval_overall <- (sum(null_overall >= obs$overall) + 1) / (nperm + 1)

cat("Permutation p-value (mean per-locus FST) =", pval_mean, "\n")
cat("Permutation p-value (overall FST) =", pval_overall, "\n")

############################
# 5) Write outputs
############################
write.table(null_mean,
            file=file.path(out_dir, "null_mean_perlocus_fst.txt"),
            row.names=FALSE, col.names=FALSE, quote=FALSE)

write.table(null_overall,
            file=file.path(out_dir, "null_overall_fst.txt"),
            row.names=FALSE, col.names=FALSE, quote=FALSE)

summary_file <- file.path(out_dir, "summary.txt")
writeLines(c(
  paste0("sync_file\t", sync_file),
  paste0("meta_file\t", meta_file),
  paste0("npools\t", pd@npools),
  paste0("nsnp_used\t", pd@nsnp),
  paste0("nperm\t", nperm),
  paste0("obs_mean_perlocus_fst\t", format(obs$mean_perlocus, digits=10)),
  paste0("pvalue_mean_perlocus_fst\t", format(pval_mean, digits=10)),
  paste0("obs_overall_fst\t", format(obs$overall, digits=10)),
  paste0("pvalue_overall_fst\t", format(pval_overall, digits=10)),
  "filters\tmin.rc=4; min.cov.per.pool=10; max.cov.per.pool=1e6; min.maf=0.05; noindel=TRUE"
), con=summary_file)

cat("DONE. Outputs in:", out_dir, "\n")

