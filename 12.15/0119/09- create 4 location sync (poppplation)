cat > $BASE/make_sync_batlow_feral_exclF1_F12.sbatch <<'EOF'
#!/bin/bash
#SBATCH --job-name=batlow_feral_sync
#SBATCH --partition=Standard
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --output=/mnt/data/wright/home/u8021786/popoolation2_project/slurm_%j_batlow_feral_sync.out
#SBATCH --error=/mnt/data/wright/home/u8021786/popoolation2_project/slurm_%j_batlow_feral_sync.err

set -euo pipefail

BASE=/mnt/data/wright/home/u8021786/popoolation2_project
REF=$BASE/ref/Amel_HAv3.1.fna
MAPDIR=$BASE/map
OUTDIR=$BASE/sync

source /opt/conda/etc/profile.d/conda.sh
conda activate popoolation2

P2JAR="$CONDA_PREFIX/share/popoolation2-1.201-0/mpileup2sync.jar"

SCRATCH=/mnt/data/wright/home/scratch/u8021786/batlow_feral_sync_$SLURM_JOB_ID
mkdir -p "$SCRATCH" "$OUTDIR"

# Batlow feral BAMs (exclude BF1 and BF12)
BAMS=(
  $MAPDIR/batlow_feral/BatlowBF2.bam
  $MAPDIR/batlow_feral/BatlowBF3.bam
  $MAPDIR/batlow_feral/BatlowBF4.bam
  $MAPDIR/batlow_feral/BatlowBF5.bam
  $MAPDIR/batlow_feral/BatlowBF6.bam
  $MAPDIR/batlow_feral/BatlowBF7.bam
  $MAPDIR/batlow_feral/BatlowBF8.bam
  $MAPDIR/batlow_feral/BatlowBF9.bam
  $MAPDIR/batlow_feral/BatlowBF10.bam
  $MAPDIR/batlow_feral/BatlowBF11.bam
  $MAPDIR/batlow_feral/BatlowBF13.bam
  $MAPDIR/batlow_feral/BatlowBF14.bam
)

# sanity check
for b in "${BAMS[@]}"; do
  [[ -f "$b" ]] || { echo "Missing BAM: $b"; exit 1; }
  [[ -f "$b.bai" ]] || { echo "Missing BAI: $b.bai"; exit 1; }
done

# mpileup
samtools mpileup -B -f "$REF" "${BAMS[@]}" > "$SCRATCH/batlow_feral_exclF1_F12.mpileup"

# mpileup → sync
java -Xmx28g -jar "$P2JAR" \
  --input "$SCRATCH/batlow_feral_exclF1_F12.mpileup" \
  --output "$SCRATCH/batlow_feral_exclF1_F12.sync" \
  --fastq-type sanger \
  --min-qual 20 \
  --threads "$SLURM_CPUS_PER_TASK"

mv "$SCRATCH/batlow_feral_exclF1_F12.sync" "$OUTDIR/"
rm -rf "$SCRATCH"

echo "DONE: $OUTDIR/batlow_feral_exclF1_F12.sync"
EOF


