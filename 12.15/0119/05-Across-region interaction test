metadata <- data.frame(
  sample = sample_names,
  region = ifelse(grepl("^Young", sample_names), "Young", "Batlow"),
  feral  = ifelse(grepl("BF", sample_names), "feral", "managed"),
  stringsAsFactors = FALSE
)

metadata$region <- factor(metadata$region)
metadata$feral  <- factor(metadata$feral)

table(metadata$region, metadata$feral)
head(metadata)

