library(poolfstat)
sync_file <- "/mnt/data/wright/home/u8021786/popoolation2_project/sync/all_regions.sync"

# # Infer the number of pools by reading the first line
first_line <- readLines(sync_file, n = 1)
n_cols <- length(strsplit(first_line, "\t")[[1]])
n_pools <- n_cols - 3

cat("n_pools =", n_pools, "\n")

# poolsizes
n_ind <- 10
poolsizes <- rep(2 * n_ind, n_pools)

pooldata <- popsync2pooldata(sync.file = sync_file, poolsizes = poolsizes)

fst_matrix <- compute.pairwiseFST(pooldata)
fst <- fst_matrix@PairwiseFSTmatrix

linear_fst <- fst / (1 - fst)

dist_obj <- as.dist(linear_fst)

# check euclidean
library(ade4)
is.euclid(dist_obj)

# result: FALSE
dist_eucl <- cailliez(dist_obj)

#create metadata
