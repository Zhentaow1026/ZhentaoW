#!/bin/bash
#SBATCH --job-name=all_sync
#SBATCH --partition=Standard
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --output=/mnt/data/wright/home/u8021786/popoolation2_project/slurm_%j_all_sync.out
#SBATCH --error=/mnt/data/wright/home/u8021786/popoolation2_project/slurm_%j_all_sync.err

set -euo pipefail

BASE=/mnt/data/wright/home/u8021786/popoolation2_project
REF=$BASE/ref/Amel_HAv3.1.fna
BAMLIST=$BASE/meta/all_regions_bams_order.txt
OUTDIR=$BASE/sync

SCR=/mnt/data/wright/home/scratch/u8021786/all_sync_${SLURM_JOB_ID}
mkdir -p "$SCR" "$OUTDIR"

source /opt/conda/etc/profile.d/conda.sh
conda activate popoolation2

P2JAR="$CONDA_PREFIX/share/popoolation2-1.201-0/mpileup2sync.jar"

# check bams + bai exist
while read -r b; do
  [[ -f "$b" ]] || { echo "Missing BAM: $b" >&2; exit 1; }
  [[ -f "${b}.bai" ]] || { echo "Missing BAI: ${b}.bai" >&2; exit 1; }
done < "$BAMLIST"

# mpileup
samtools mpileup -B -f "$REF" $(cat "$BAMLIST") > "$SCR/all_regions.mpileup"

# sync
java -ea -Xmx28g -jar "$P2JAR" \
  --input "$SCR/all_regions.mpileup" \
  --output "$SCR/all_regions.sync" \
  --fastq-type sanger \
  --min-qual 20 \
  --threads "${SLURM_CPUS_PER_TASK}"

cp -av "$SCR/all_regions.sync" "$OUTDIR/all_regions.sync"
echo "DONE: $OUTDIR/all_regions.sync"
EOF

