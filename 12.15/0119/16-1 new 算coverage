cat > $BASE/qc_pick_maxcov.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

# Usage: ./qc_pick_maxcov.sh input.sync [mincov] [sample_lines]
SYNC=${1:?need input .sync}
MINCOV=${2:-50}
SAMPLE_LINES=${3:-2000000}

echo "FILE   : $SYNC"
echo "MINCOV : $MINCOV"
echo "SAMPLE : $SAMPLE_LINES (max)"

TOTAL=$(wc -l < "$SYNC")
if (( TOTAL <= SAMPLE_LINES )); then
  CMD="cat"
else
  p=$(awk -v s="$SAMPLE_LINES" -v t="$TOTAL" 'BEGIN{print s/t}')
  CMD="awk -v p=$p 'BEGIN{srand()} rand()<p'"
fi

tmp=$(mktemp)
eval "$CMD \"$SYNC\"" \
| awk -F'\t' -v min="$MINCOV" '
  function cov(s, a){ split(s,a,":"); return a[1]+a[2]+a[3]+a[4] }
  { c1=cov($4); c2=cov($5); if(c1>=min && c2>=min) print c1"\t"c2 }
' > "$tmp"

N=$(wc -l < "$tmp")
echo "USED   : $N lines (both groups >= $MINCOV)"

quantile_col () {
  local col=$1
  cut -f"$col" "$tmp" | sort -n > "${tmp}.c${col}"
  local n=$(wc -l < "${tmp}.c${col}")
  awk -v n="$n" '
    function at(p){ i=int(p*n); if(i<1)i=1; if(i>n)i=n; return i }
    { a[NR]=$1 }
    END{
      printf "N=%d  P50=%d  P90=%d  P95=%d  P99=%d  Max=%d\n",
             n, a[at(0.50)], a[at(0.90)], a[at(0.95)], a[at(0.99)], a[n]
    }' "${tmp}.c${col}"
}

echo "FERAL  coverage (A+T+C+G):"
q1=$(quantile_col 1)
echo "  $q1"

echo "MANAGED coverage (A+T+C+G):"
q2=$(quantile_col 2)
echo "  $q2"

p99_feral=$(echo "$q1" | sed -n 's/.*P99=\([0-9]\+\).*/\1/p')
p99_manag=$(echo "$q2" | sed -n 's/.*P99=\([0-9]\+\).*/\1/p')

maxp99=$p99_feral
if (( p99_manag > maxp99 )); then maxp99=$p99_manag; fi

echo "RECOMMEND: --max-coverage $maxp99  (max of P99 across groups)"

rm -f "$tmp" "${tmp}.c1" "${tmp}.c2"
EOF

#给执行权限
chmod +x $BASE/qc_pick_maxcov.sh

