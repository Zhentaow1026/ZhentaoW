#!/bin/bash
#SBATCH --job-name=BL_fstSNP
#SBATCH --partition=Standard
#SBATCH --cpus-per-task=2
#SBATCH --mem=24G
#SBATCH --time=12:00:00
#SBATCH --output=/mnt/data/wright/home/u8021786/popoolation2_project/pop2_batlow_2pop/logs/%x_%j.out
#SBATCH --error=/mnt/data/wright/home/u8021786/popoolation2_project/pop2_batlow_2pop/logs/%x_%j.err

set -euo pipefail

BASE=/mnt/data/wright/home/u8021786/popoolation2_project
SYNC=$BASE/sync/batlow_F_vs_M_2pop.sync
OUT=$BASE/pop2_batlow_2pop
mkdir -p "$OUT"

source /opt/conda/etc/profile.d/conda.sh
conda activate popoolation2

# 使用 conda 环境中实际存在的脚本路径（bin/ 下）
SCRIPT="$CONDA_PREFIX/bin/fst-sliding.pl"
[[ -f "$SCRIPT" ]] || { echo "Missing script: $SCRIPT" >&2; exit 1; }

# 合并后 poolsize：240 vs 280，教程脚本只能给一个 pool-size
# 先用折中值 260（你也可以改成 240 或 280）
POOLSIZE=260

perl "$SCRIPT" \
  --input "$SYNC" \
  --output "$OUT/batlow_F_vs_M.SNP.fst" \
  --suppress-noninformative \
  --min-count 6 \
  --min-coverage 50 \
  --max-coverage 200 \
  --min-covered-fraction 1 \
  --window-size 1 \
  --step-size 1 \
  --pool-size $POOLSIZE

echo "DONE step2: $OUT/batlow_F_vs_M.SNP.fst"
EOF

