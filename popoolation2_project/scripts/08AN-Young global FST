cat > young_perm_new.R << 'RSCRIPT'
library(poolfstat)

BASE      <- "~/popoolation2_project"
sync_file <- paste0(BASE, "/sync/young_all.sync")
out_dir   <- paste0(BASE, "/perm_young_new")
dir.create(out_dir, showWarnings=FALSE, recursive=TRUE)

# ref: https://cran.r-project.org/web/packages/poolfstat/refman/poolfstat.html#topic+popsync2pooldata
pd <- popsync2pooldata(
  sync.file        = sync_file,
  poolsizes        = rep(20, 20),
  min.rc           = 4,
  min.cov.per.pool = 10,
  max.cov.per.pool = 927,
  min.maf          = 0.05,
  noindel          = TRUE,
  nthreads         = 2
)

# compute FST, used struct
labels  <- c(rep("feral", 10), rep("managed", 10))
fst_obs <- computeFST(pd, method="Anova", struct=labels, verbose=FALSE)
obs_fst <- fst_obs$Fgt[1]   # choose Fgt represent FST

set.seed(1)
nperm    <- 1000
null_fst <- numeric(nperm)

# ref: https://mac-theobio.github.io/QMEE/lectures/permutation_examples.notes.html
for (i in 1:nperm) {
  perm_labels <- sample(labels)
  fst_perm    <- computeFST(pd, method="Anova",
                             struct=perm_labels, verbose=FALSE)
  null_fst[i] <- fst_perm$Fgt[1]   # Fgt represent FST
}

pval <- (sum(null_fst >= obs_fst) + 1) / (nperm + 1) # +1: to avoid obtaining p = 0 when the number of permutations is limited.

write.table(null_fst,
            file      = file.path(out_dir, "null_fst.txt"),
            row.names = FALSE,
            col.names = FALSE,
            quote     = FALSE)

cat("Observed FST =", obs_fst, "\n")
cat("Permutation p-value =", pval, "\n")
RSCRIPT